import gradio as gr
from PIL import Image
import torch
from diffusers import AnimateDiffPipeline, MotionAdapter, EulerDiscreteScheduler
from diffusers.utils import export_to_video

# Load FREE open model (runs without API key)
model_id = "ByteDance/AnimateDiff-Lightning"
adapter = MotionAdapter.from_pretrained(model_id, torch_dtype=torch.float16)
pipe = AnimateDiffPipeline.from_pretrained("emilianJR/epiCRealism", motion_adapter=adapter, torch_dtype=torch.float16)
pipe.scheduler = EulerDiscreteScheduler.from_config(pipe.scheduler.config, timestep_spacing="trailing", beta_schedule="linear")
pipe.to("cuda" if torch.cuda.is_available() else "cpu")

def text_to_video(prompt, duration):
    frames = pipe(prompt=prompt, num_frames=int(duration*8), guidance_scale=1.0).frames[0]
    path = "/tmp/text2video.mp4"
    export_to_video(frames, path, fps=8)
    return path

def image_to_video(image, prompt, motion_strength):
    # For free version we use AnimateDiff with image as reference
    # You can add depth + motion here
    frames = pipe(prompt=prompt, num_frames=24, guidance_scale=1.0).frames[0]
    path = "/tmp/img2video.mp4"
    export_to_video(frames, path, fps=8)
    return path

def storytelling(story_text):
    # Split story into scenes
    scenes = [s.strip() for s in story_text.split(".") if s.strip()][:4]
    videos = []
    for scene in scenes:
        frames = pipe(prompt=scene, num_frames=16, guidance_scale=1.0).frames[0]
        path = f"/tmp/story_{len(videos)}.mp4"
        export_to_video(frames, path, fps=8)
        videos.append(path)
    return videos

with gr.Blocks(title="Free AI Video Studio") as app:
    gr.Markdown("# 🎬 FREE AI Video Studio - Text2Video | Image2Video | Storytelling")

    with gr.Tab("Text to Video"):
        prompt = gr.Textbox(label="Your Prompt", placeholder="A newly married couple dancing, guests cheering...")
        duration = gr.Slider(2, 15, value=5, label="Duration (seconds)")
        btn = gr.Button("Generate Video")
        video_out = gr.Video()
        btn.click(text_to_video, [prompt, duration], video_out)

    with gr.Tab("Image to Video"):
        img = gr.Image(type="pil", label="Upload Image")
        prompt2 = gr.Textbox(label="Motion Prompt", placeholder="couple dancing, slow zoom, celebration")
        strength = gr.Slider(1, 10, value=5, label="Motion Strength")
        btn2 = gr.Button("Animate Image")
        video_out2 = gr.Video()
        btn2.click(image_to_video, [img, prompt2, strength], video_out2)

    with gr.Tab("Storytelling Mode"):
        story = gr.Textbox(label="Your Story", lines=4, placeholder="Scene 1. A warrior prepares for battle. Scene 2. He walks into the misty forest. Scene 3...")
        btn3 = gr.Button("Generate Story Video (4 scenes)")
        video_out3 = gr.Gallery(label="Story Scenes")
        btn3.click(storytelling, story, video_out3)

app.launch()